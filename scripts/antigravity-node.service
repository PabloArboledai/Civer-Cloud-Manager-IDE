[Unit]
Description=Antigravity Manager (Headless Node)
After=network.target tailscaled.service
Requires=tailscaled.service

[Service]
User=miguel
WorkingDirectory=/home/miguel/Antigravity-Manager/src-tauri
Environment="RUST_LOG=info"
Environment="PORT=1420"
# Executable generated by cargo build --release
ExecStart=/home/miguel/Antigravity-Manager/src-tauri/target/release/antigravity_tools
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
